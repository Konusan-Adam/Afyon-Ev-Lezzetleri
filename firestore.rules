rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Temel Güvenlik Ağı (Varsayılan Olarak Tüm Erişimleri Engelle)
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Güvenlik ve Doğrulama Yardımcı Fonksiyonları
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTedarikciHakedis(data, hakedisId) {
      return data.keys().hasAll([
          'id', 'sube_id', 'sube_adi', 'tedarikci_id', 'tedarikci_adi',
          'urun_id', 'urun_adi', 'teslim_adedi', 'satilan_adet',
          'birim_alis_fiyati', 'toplam_hakedis', 'durum', 'tarih'
        ]) &&
        data.keys().hasOnly([
          'id', 'sube_id', 'sube_adi', 'tedarikci_id', 'tedarikci_adi',
          'urun_id', 'urun_adi', 'teslim_adedi', 'satilan_adet',
          'birim_alis_fiyati', 'toplam_hakedis', 'durum', 'tarih'
        ]) &&
        data.id == hakedisId &&
        data.sube_id is string && data.sube_id.size() > 0 && data.sube_id.size() <= 64 &&
        data.sube_adi is string && data.sube_adi.size() > 0 && data.sube_adi.size() <= 150 &&
        data.tedarikci_id is string && data.tedarikci_id.size() > 0 && data.tedarikci_id.size() <= 128 &&
        data.tedarikci_adi is string && data.tedarikci_adi.size() > 0 && data.tedarikci_adi.size() <= 150 &&
        data.urun_id is string && data.urun_id.size() > 0 && data.urun_id.size() <= 128 &&
        data.urun_adi is string && data.urun_adi.size() > 0 && data.urun_adi.size() <= 150 &&
        data.teslim_adedi is number && data.teslim_adedi >= 0 &&
        data.satilan_adet is number && data.satilan_adet >= 0 &&
        data.birim_alis_fiyati is number && data.birim_alis_fiyati >= 0 &&
        data.toplam_hakedis is number && data.toplam_hakedis >= 0 &&
        data.durum in ['beklemede', 'onaylandi', 'odendi', 'reddedildi', 'iptal'] &&
        data.tarih is string && data.tarih.size() > 0 && data.tarih.size() <= 64;
    }

    // 2. Bağlantı Sağlık Kontrolü
    match /test/{docId} {
      allow read: if true;
    }

    // 3. Menü, Kategoriler ve Mutfak Vitrini (Herkese Okunabilir, Güvenli Yazma)
    match /kategoriler/{kategoriId} {
      allow read: if true;
      allow write: if isValidId(kategoriId);
    }

    match /alt_kategoriler/{altKategoriId} {
      allow read: if true;
      allow write: if isValidId(altKategoriId);
    }

    match /mutfaklar/{mutfakId} {
      allow read: if true;
      allow write: if isValidId(mutfakId);
    }

    match /yemekler/{yemekId} {
      allow read: if true;
      allow write: if isValidId(yemekId) && incoming().fiyat is number && incoming().fiyat > 0;
    }

    // 4. Canlı Siparişler (Fiyat Korumalı ve Durum Kilitli)
    match /siparisler/{siparisId} {
      allow read: if true;
      allow create: if isValidId(siparisId) &&
                    incoming().durum is string &&
                    (!('toplam_tutar' in incoming()) || (incoming().toplam_tutar is number && incoming().toplam_tutar >= 0));
      allow update: if isValidId(siparisId) && incoming().durum is string;
      allow delete: if isValidId(siparisId);
    }

    // 5. Kullanıcı Hesapları ve Misafirler
    match /kullanicilar/{kullaniciId} {
      allow read: if true;
      allow write: if isValidId(kullaniciId);
    }

    match /misafir_kullanicilar/{misafirId} {
      allow read: if true;
      allow write: if isValidId(misafirId);
    }

    match /musteri_adresleri/{adresId} {
      allow read: if true;
      allow write: if isValidId(adresId);
    }

    match /musteri_favorileri/{favoriId} {
      allow read: if true;
      allow write: if isValidId(favoriId) &&
                    incoming().mutfakIdleri is list &&
                    incoming().subeIdleri is list;
    }

    // 6. Sepet ve Grup Siparişi
    match /sepet_elemanlari/{sepetId} {
      allow read: if true;
      allow write: if isValidId(sepetId);
    }

    match /ortak_sepetler/{sepetId} {
      allow read: if true;
      allow write: if isValidId(sepetId);
    }

    match /ortak_sepet_elemanlari/{elemanId} {
      allow read: if true;
      allow write: if isValidId(elemanId);
    }

    match /ortak_sepet_katilimcilari/{katilimciId} {
      allow read: if true;
      allow write: if isValidId(katilimciId);
    }

    // 7. Kurye Canlı GPS Konumları (Koordinat Tip Korumalı)
    match /kurye_konumlari/{konumId} {
      allow read: if true;
      allow write: if isValidId(konumId) && 
                    incoming().enlem is number && 
                    incoming().boylam is number;
    }

    // 8. Müşteri Değerlendirmeleri ve Puanlama
    match /degerlendirmeler/{degerlendirmeId} {
      allow read: if true;
      allow write: if isValidId(degerlendirmeId);
    }

    // 9. Sistem ve Genel Ayarlar Merkezi
    match /genel_ayarlar/{ayarId} {
      allow read: if true;
      allow write: if isValidId(ayarId);
    }

    // 10. Kampanyalar ve Gel-Al Şubeleri
    match /kampanyalar/{kampanyaId} {
      allow read: if true;
      allow write: if isValidId(kampanyaId);
    }

    match /gel_al_subeleri/{subeId} {
      allow read: if true;
      allow write: if isValidId(subeId);
    }

    match /sube_stoklari/{stokId} {
      allow read: if true;
      allow create: if isValidId(stokId) &&
                    incoming().id is string && incoming().id == stokId &&
                    incoming().sube_id is string && incoming().sube_id.size() > 0 && incoming().sube_id.size() <= 64 &&
                    incoming().ad is string && incoming().ad.size() > 0 && incoming().ad.size() <= 150 &&
                    incoming().fiyat is number && incoming().fiyat >= 0 &&
                    incoming().stok_adedi is number && incoming().stok_adedi >= 0;
      allow update: if isValidId(stokId) &&
                    incoming().stok_adedi is number && incoming().stok_adedi >= 0 &&
                    (!('fiyat' in incoming()) || (incoming().fiyat is number && incoming().fiyat >= 0)) &&
                    (!('alis_fiyati' in incoming()) || (incoming().alis_fiyati is number && incoming().alis_fiyati >= 0)) &&
                    (!('gunluk_gelen_adet' in incoming()) || (incoming().gunluk_gelen_adet is number && incoming().gunluk_gelen_adet >= 0)) &&
                    (!('satilan_adet' in incoming()) || (incoming().satilan_adet is number && incoming().satilan_adet >= 0)) &&
                    (!('tedarikci_adi' in incoming()) || (incoming().tedarikci_adi is string && incoming().tedarikci_adi.size() <= 150));
      allow delete: if isValidId(stokId);
    }

    match /sube_siparisleri/{siparisId} {
      allow read: if true;
      allow create: if isValidId(siparisId) &&
                    incoming().id is string && incoming().id == siparisId &&
                    incoming().sube_id is string && incoming().sube_id.size() > 0 && incoming().sube_id.size() <= 64 &&
                    incoming().toplam_tutar is number && incoming().toplam_tutar >= 0 &&
                    incoming().durum in ['hazirlaniyor', 'teslime_hazir', 'teslim_edildi', 'iptal'];
      allow update: if isValidId(siparisId) &&
                    incoming().durum in ['hazirlaniyor', 'teslime_hazir', 'teslim_edildi', 'iptal'] &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['durum', 'odeme_durumu', 'tahmini_hazirlanma_dakika']);
      allow delete: if isValidId(siparisId);
    }

    match /mutfak_afisleri/{afisId} {
      allow read: if true;
      allow write: if isValidId(afisId);
    }

    match /coklu_menuler/{menuId} {
      allow read: if true;
      allow write: if isValidId(menuId);
    }

    match /tamamlanan_siparisler/{siparisId} {
      allow read: if true;
      allow write: if isValidId(siparisId);
    }

    match /tedarikci_hakedisleri/{hakedisId} {
      allow read: if true;
      allow create: if isValidId(hakedisId) && isValidTedarikciHakedis(incoming(), hakedisId);
      allow update: if isValidId(hakedisId) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['durum', 'satilan_adet', 'toplam_hakedis']) &&
                    incoming().durum in ['beklemede', 'onaylandi', 'odendi', 'reddedildi', 'iptal'] &&
                    incoming().satilan_adet is number && incoming().satilan_adet >= 0 &&
                    incoming().toplam_hakedis is number && incoming().toplam_hakedis >= 0;
      allow delete: if isValidId(hakedisId);
    }

    // 11. Hukuki Onaylar, Sözleşmeler, Faturalar ve Bildirimler
    match /sozlesmeler/{sozlesmeId} {
      allow read: if true;
      allow write: if isValidId(sozlesmeId);
    }

    match /hukuki_onay_loglari/{logId} {
      allow read: if true;
      allow write: if isValidId(logId);
    }

    match /faturalar/{faturaId} {
      allow read: if true;
      allow write: if isValidId(faturaId);
    }

    match /hakedis_talepleri/{talepId} {
      allow read: if true;
      allow write: if isValidId(talepId);
    }

    match /patron_bildirimleri/{bildirimId} {
      allow read: if true;
      allow create: if isValidId(bildirimId) &&
                    incoming().id is string && incoming().id == bildirimId &&
                    incoming().tur is string && incoming().tur.size() > 0 && incoming().tur.size() <= 50 &&
                    incoming().baslik is string && incoming().baslik.size() > 0 && incoming().baslik.size() <= 200 &&
                    incoming().detay is string && incoming().detay.size() <= 1000 &&
                    incoming().okundu_mu is bool;
      allow update: if isValidId(bildirimId) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['okundu_mu']) &&
                    incoming().okundu_mu is bool;
      allow delete: if isValidId(bildirimId);
    }

    match /komisyon_ayarlari/{komisyonId} {
      allow read: if true;
      allow write: if isValidId(komisyonId);
    }

    match /paytr_oturumlari/{oturumId} {
      allow read: if true;
      allow write: if isValidId(oturumId) &&
                    incoming().merchantOid is string &&
                    incoming().merchantOid.size() <= 80 &&
                    incoming().durum in ['bekliyor', 'odendi', 'hata'];
    }
  }
}
